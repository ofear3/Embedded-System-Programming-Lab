ORG 0000H

MAIN:
    MOV P2, #00H
    MOV P3, #00H

START:
    MOV R0, #00H

LOOP1:
    MOV DPTR, #SEG
    MOV A, R0
    MOVC A, @A+DPTR
    MOV P2, A

    MOV R1, #00H

LOOP2:
    MOV DPTR, #SEG
    MOV A, R1
    MOVC A, @A+DPTR
    MOV P3, A

    MOV R5, #40
WAIT:
    ACALL DELAY
    DJNZ R5, WAIT

    INC R1
    CJNE R1, #10, LOOP2

    INC R0
    CJNE R0, #10, LOOP1

    SJMP START

DELAY:
    MOV R6, #10
D1:
    MOV R7, #255
D2:
    DJNZ R7, D2
    DJNZ R6, D1
    RET

SEG:
    DB 3FH, 06H, 5BH, 4FH, 66H
    DB 6DH, 7DH, 07H, 7FH, 6FH

END
